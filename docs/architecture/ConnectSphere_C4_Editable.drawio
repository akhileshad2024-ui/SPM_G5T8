        <mxCell id="persistence" parent="1" vertex="1" value="Shared Persistence&#10;backend/database.py + models.py + schemas.py; auth/models.py owns User&#10;SQLAlchemy sessions and models → PostgreSQL. Business components use this shared data layer." style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#DCECF8;fontColor=#102A43;strokeColor=#64748B;">
          <mxGeometry as="geometry" x="530" y="1325" width="1060" height="130" />
        </mxCell>
        <mxCell id="e13" parent="1" edge="1" source="api" target="persistence" value="Uses database session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" parent="1" vertex="1" value="Selected principal dependencies are shown to keep this view readable. API routes also invoke the lower-row components.&#10;Business components record their own changes through shared SQLAlchemy persistence and request notifications where required.&#10;Components are packages inside one FastAPI application, not microservices. Notion M1–M5 remain historical planning workstreams.&#10;mail_worker.py is shown as a separate retry process in C2; API background tasks use the same delivery code." style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#FFFFFF;fontColor=#334155;strokeColor=#64748B;">
          <mxGeometry as="geometry" x="110" y="1490" width="1880" height="125" />

        </mxCell>
        <mxCell id="e0" parent="1" edge="1" source="users" target="web" value="Uses web application / HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" parent="1" edge="1" source="web" target="api" value="/api proxy → FastAPI / HTTP(S), JSON, session cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" parent="1" edge="1" source="api" target="db" value="Reads and writes / SQLAlchemy + Psycopg, PostgreSQL protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" parent="1" edge="1" source="worker" target="db" value="Reads outbox and records delivery results / PostgreSQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e4" parent="1" edge="1" source="worker" target="smtp" value="Sends queued mail / SMTP with TLS when configured" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e5" parent="1" edge="1" source="api" target="smtp" value="Also attempts committed mail delivery through background tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;labelBackgroundColor=#FFFFFF;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" parent="1" vertex="1" value="Local development uses HTTP; production credentials require TLS. Database access is server-side.&#10;Authentication uses application users and signed session cookies, not Supabase Auth.&#10;The hold-expiry sweeper is a thread inside FastAPI, not a separate container. The retry worker is started separately." style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;fontFamily=Arial;fontSize=17;fillColor=#FFFFFF;fontColor=#334155;strokeColor=#64748B;">
          <mxGeometry as="geometry" x="220" y="1170" width="1360" height="130" />
        </mxCell>
      </root>
    </mxGraphModel>

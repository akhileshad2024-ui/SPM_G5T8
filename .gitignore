# python test coverage
.coverage
htmlcov/
# per-story coverage reports (run_coverage.py): keep the text reports + history.csv, skip the bulky parts
coverage_reports/**/htmlcov/
coverage_reports/**/.coverage

# Local transfer artifacts
*.bundle

# Keep only replaceable working outputs out of Git; timestamped reports are versioned.
/coverage_reports/project/latest/
/coverage_reports/**/latest/
# Preserve the previous Git policy for older local-only archives and diagnostic runs.
/coverage_reports/**/archived/
/coverage_reports/**/history/
